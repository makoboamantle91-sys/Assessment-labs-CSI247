        return hours;
     }
     public void sethours(int hours){
        this.hours = hours;
     }
     public int getpayperhour(){
        return payperhour;
     }
     public void setpayperhour(double payperhour){
        this.payperhour = payperhour;
     }
          
     public int computeSalary(){
        return Salary this.hours * this.payperhour";
     }
        @Override
    public String toString(){
     return "Teacher [Name=" + getname() + ", Id=" + getid() +  ", Subject=" + subject + ", Hours=" + hours + ", PayPerHour=" + payperhour + "]";
    }
@Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }
        if (obj == null || getClass() != obj.getClass()) {
            return false;
        }
        
        Teacher other = (Teacher) obj;

        return this.subject.equalsIgnoreCase(other.subject) && 
               this.getid() == other.getid() && 
               Double.compare(this.computeSalary(), other.computeSalary()) == 0;
    }
}     
